# App
HAQQI_CORE_APP_NAME="Haqqi Core"
HAQQI_CORE_APP_VERSION="0.1.0"
HAQQI_CORE_API_PREFIX="/api/v1"
HAQQI_CORE_LOG_LEVEL="INFO"

# Data
# Local open-source dataset folder
HAQQI_CORE_SOURCE_DIR="data/raw-bulletin-officiel"
HAQQI_CORE_SOURCE_GLOB_PATTERN="**/*.pdf"
HAQQI_CORE_PDF_PARSER_BACKEND="auto" # auto | pypdf | docling

# Qdrant (local path mode)
HAQQI_CORE_QDRANT_PATH="data/qdrant"

# Qdrant (remote mode - optional)
HAQQI_CORE_QDRANT_URL=""
HAQQI_CORE_QDRANT_API_KEY=""

HAQQI_CORE_QDRANT_COLLECTION_NAME="moroccan_law"
HAQQI_CORE_EMBEDDING_MODEL_NAME="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"

# Ingestion / retrieval
HAQQI_CORE_DEFAULT_CHUNK_SIZE=1200
HAQQI_CORE_DEFAULT_CHUNK_OVERLAP=200
HAQQI_CORE_INGESTION_BATCH_SIZE=64
HAQQI_CORE_QUERY_TOP_K=6
HAQQI_CORE_RETRIEVAL_DENSE_K=30
HAQQI_CORE_RETRIEVAL_CANDIDATE_K=500
HAQQI_CORE_RETRIEVAL_RERANKER_MODE="late_interaction"
HAQQI_CORE_RETRIEVAL_COLBERT_COLLECTION_NAME="moroccan_law_colbert"
HAQQI_CORE_RETRIEVAL_COLBERT_MODEL_NAME="colbert-ir/colbertv2.0"
HAQQI_CORE_RETRIEVAL_COLBERT_VECTOR_NAME="colbert"
HAQQI_CORE_RETRIEVAL_COLBERT_BATCH_SIZE=8
HAQQI_CORE_RETRIEVAL_COLBERT_ON_DISK_VECTORS=true
